{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" session-start || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" session-start || exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell|Monitor|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" pre-tool || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" pre-tool || exit 2",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" prompt || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" prompt || exit 2",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
