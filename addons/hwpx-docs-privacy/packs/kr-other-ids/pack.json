    ]
   }
  },
  {
   "id": "case",
   "label": "사건번호",
   "group": "E",
   "level": "strict",
   "numeric": false,
   "disclose": "none",
   "patterns": [
    {
     "re": "(?<!\\d)(?:19|20)\\d{2}\\s?(?:가합|가단|가소|고합|고단|고정|구합|구단|드단|드합|느단|느합|하단|하합|나|다|도|노|머|카|타|재|차|아|저|허|후|라|마|무|부|스|으|즈|초|코|푸|호)\\s?\\d{1,7}(?!\\d)"
    }
   ],
   "labels": [
    "사건번호",
    "사건 번호",
    "사건"
   ],
   "value": "(?:19|20)\\d{2}\\s?[가-힣]{1,3}\\s?\\d{1,7}",
   "tests": {
    "pos": [
     [
      "사건번호 2025가합12345",
      "2025가합12345"
     ],
     [
      "2024 노 1234 항소",
      "2024 노 1234"
     ],
     [
      "사건 2023고단4567",
      "2023고단4567"
     ]
    ],
    "neg": [
     "2026년 11월"
    ]
   }
  },
  {
