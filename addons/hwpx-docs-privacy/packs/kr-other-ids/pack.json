{
 "name": "kr-other-ids",
 "about": "Group E, other identifiers that point to one person: student, employee, military, exam, patient / chart, health insurance, court case, petition, member, licence, ID card numbers",
 "version": 1,
 "kinds": [
  {
   "id": "sid",
   "label": "학번",
   "group": "E",
   "level": "strict",
   "numeric": false,
   "disclose": "none",
   "patterns": [],
   "labels": [
    "학번",
    "학생번호",
    "학생 번호",
    "Student ID"
   ],
   "value": "[A-Za-z]?\\d{6,10}",
   "tests": {
    "pos": [
     [
      "학번 2021123456",
      "2021123456"
     ]
    ],
    "neg": [
     "학번 기재"
    ]
   }
  },
  {
   "id": "eid",
   "label": "사번",
   "group": "E",
   "level": "strict",
   "numeric": false,
   "disclose": "none",
   "patterns": [],
   "labels": [
    "사번",
    "사원번호",
    "직원번호",
    "교직원번호",
    "공무원번호",
    "Employee ID",
    "Emp No\\.?"
   ],
   "value": "[A-Za-z]{0,3}\\d{4,10}",
   "tests": {
    "pos": [
     [
      "사원번호 A1234567",
      "A1234567"
     ],
     [
      "사번: 20180034",
      "20180034"
     ]
    ],
    "neg": [
     "사번 없음"
    ]
   }
  },
  {
   "id": "mid",
   "label": "군번",
   "group": "E",
   "level": "strict",
   "numeric": false,
   "disclose": "none",
   "patterns": [],
   "labels": [
    "군번",
    "군 번"
   ],
   "value": "\\d{2}-\\d{5,8}|\\d{8,10}",
   "tests": {
    "pos": [
     [
      "군번 19-76012345",
      "19-76012345"
     ]
    ],
    "neg": [
     "군번 미기재"
    ]
   }
  },
  {
   "id": "exam",
   "label": "수험번호",
