{
 "name": "kr-identifiers",
 "about": "Group A, unique identifiers (PIPA art. 24, 24-2): resident registration number, foreigner registration number, passport, driving licence",
 "version": 1,
 "kinds": [
  {
   "id": "rrn",
   "label": "주민번호",
   "group": "A",
   "level": "standard",
   "numeric": true,
   "disclose": "rrn",
   "patterns": [
    {
     "re": "(?<![\\d-])\\d{6}\\s?[-.]\\s?[1-490]\\d{6}(?![\\d-])",
     "check": "rrn"
    },
    {
     "re": "(?<!\\d)\\d{6}[1-490]\\d{6}(?!\\d)",
     "check": "rrn"
    },
    {
     "re": "(?<![\\d-])\\d{6}\\s?[-.]\\s?[1-8]\\d{0,5}[*●○xX＊]{1,6}(?![\\d-])",
     "check": "rrn7"
    }
   ],
   "labels": [
    "주민등록번호",
    "주민번호",
    "주민 등록 번호"
   ],
   "value": "\\d{6}\\s?[-–]?\\s?[1-490]\\d{6}",
   "tests": {
    "pos": [
     [
      "주민등록번호 850312-1234565 입니다",
      "850312-1234565"
     ],
     [
      "921105-2345675",
      "921105-2345675"
     ],
     [
      "0507303123450",
      "0507303123450"
     ],
     [
      "성명 홍 주민번호: 050730 - 3123450",
      "050730 - 3123450"
     ]
    ],
    "neg": [
     "전화 02-123-4567",
     "문서번호 2026-1234567",
     "코드 991340-1234567"
    ]
   }
  },
  {
   "id": "frn",
   "label": "외국인번호",
   "group": "A",
   "level": "standard",
   "numeric": true,
   "disclose": "rrn",
   "patterns": [
    {
     "re": "(?<![\\d-])\\d{6}\\s?[-.]\\s?[5-8]\\d{6}(?![\\d-])",
     "check": "frn"
    },
    {
     "re": "(?<!\\d)\\d{6}[5-8]\\d{6}(?!\\d)",
     "check": "frn"
    }
   ],
   "labels": [
    "외국인등록번호",
    "외국인 등록번호",
    "국내거소신고번호",
    "거소신고번호",
    "외국국적동포"
   ],
   "value": "\\d{6}\\s?[-–]?\\s?[5-8]\\d{6}",
   "tests": {
    "pos": [
     [
      "외국인등록번호 890214-5123450",
      "890214-5123450"
     ],
     [
      "9508086543213",
      "9508086543213"
     ]
    ],
    "neg": [
     "일련번호 123456-9123456"
    ]
   }
  },
  {
   "id": "passport",
   "label": "여권번호",
   "group": "A",
   "level": "standard",
   "numeric": false,
   "disclose": "passport",
   "patterns": [
    {
     "re": "(?<![A-Za-z0-9])[MSROGD]\\d{8}(?!\\d)"
    },
    {
     "re": "(?<![A-Za-z0-9])[A-Z]\\d{3}[A-Z]\\d{4}(?![A-Za-z0-9])"
    }
   ],
   "labels": [
    "여권번호",
    "여권 번호",
    "Passport No\\.?",
    "Passport Number"
   ],
   "value": "[A-Z][A-Z0-9]{7,8}",
   "tests": {
    "pos": [
     [
      "여권번호 M12345678",
      "M12345678"
     ],
     [
      "passport M123A4567 end",
      "M123A4567"
     ],
     [
      "Passport No: S98765432",
      "S98765432"
     ]
    ],
    "neg": [
     "제품 AB12345678",
     "M1234567"
    ]
   }
  },
  {
   "id": "driving",
   "label": "운전면허번호",
   "group": "A",
   "level": "standard",
   "numeric": true,
   "disclose": "driving",
   "patterns": [
    {
     "re": "(?<![\\d-])\\d{2}\\s?[-.]\\s?\\d{2}\\s?[-.]\\s?\\d{6}\\s?[-.]\\s?\\d{2}(?![\\d-])",
     "check": "driving"
    }
   ],
   "labels": [
    "운전면허번호",
    "운전면허 번호",
    "면허번호"
   ],
   "value": "\\d{2}\\s?-?\\s?\\d{2}\\s?-?\\s?\\d{6}\\s?-?\\s?\\d{2}",
   "tests": {
    "pos": [
     [
      "운전면허번호 11-21-123456-01",
      "11-21-123456-01"
     ],
     [
      "면허번호: 26-18-654321-70",
      "26-18-654321-70"
     ]
    ],
    "neg": [
     "번호 99-21-123456-01"
    ]
   }
  }
 ]
}