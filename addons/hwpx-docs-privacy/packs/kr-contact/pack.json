{
 "name": "kr-contact",
 "about": "Group C, contact and location: address, postcode, phone, e-mail, SNS / messenger id, IP, MAC, GPS, car plate",
 "version": 1,
 "lists": {
  "SIDO": [
   "서울특별시",
   "서울시",
   "서울",
   "부산광역시",
   "부산시",
   "부산",
   "대구광역시",
   "대구시",
   "대구",
   "인천광역시",
   "인천시",
   "인천",
   "광주광역시",
   "광주시",
   "광주",
   "대전광역시",
   "대전시",
   "대전",
   "울산광역시",
   "울산시",
   "울산",
   "세종특별자치시",
   "세종시",
   "세종",
   "경기도",
   "경기",
   "강원특별자치도",
   "강원도",
   "강원",
   "충청북도",
   "충북",
   "충청남도",
   "충남",
   "전북특별자치도",
   "전라북도",
   "전북",
   "전라남도",
   "전남",
   "경상북도",
   "경북",
   "경상남도",
   "경남",
   "제주특별자치도",
   "제주도",
   "제주"
  ],
  "PLATE": [
   "가나다라마거너더러머버서어저고노도로모보소오조구누두루무부수우주하허호아바사자배육해공국합"
  ]
 },
 "kinds": [
  {
   "id": "address",
   "label": "주소",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "address",
   "patterns": [
    {
     "re": "(?<![가-힣])(?:\\(\\d{5}\\)\\s*|\\d{5}\\s+)?{{SIDO}}\\s*(?:[가-힣]{1,6}(?:시|군)\\s*)?(?:[가-힣]{1,6}구\\s*)?(?:[가-힣0-9]{1,10}(?:로|길)(?:\\s*\\d{1,3}번길)?\\s*\\d{1,4}(?:-\\d{1,4})?|[가-힣0-9]{1,8}(?:동|읍|면|리|가)\\s*\\d{1,4}(?:-\\d{1,4})?(?:\\s?번지)?)(?:\\s*,?\\s*[가-힣A-Za-z0-9]{1,15}(?:아파트|빌라|빌딩|타워|오피스텔|맨션|하우스|주택))?(?:\\s*,?\\s*\\d{1,4}동)?(?:\\s*,?\\s*\\d{1,4}층)?(?:\\s*,?\\s*\\d{1,4}호)?(?:\\s*\\([가-힣0-9\\s,·]{1,20}\\))?"
    },
    {
     "re": "(?<![가-힣])[가-힣]{1,6}(?:시|군|구)\\s+[가-힣0-9]{1,10}(?:로|길)\\s*\\d{1,4}(?:-\\d{1,4})?(?:\\s*,?\\s*\\d{1,4}동)?(?:\\s*,?\\s*\\d{1,4}호)?"
    }
   ],
   "labels": [
    "주소",
    "현주소",
    "주소지",
    "거주지",
    "거주지 주소",
    "소재지",
    "사업장 소재지",
    "도로명주소",
    "도로명 주소",
    "본점 소재지",
    "배송지",
    "수령지"
   ],
   "value": "[^\\n|]{6,70}",
   "value_after": "(?=\\s*(?:\\n|\\||$|\\s{3}))",
   "tests": {
    "pos": [
     [
      "서울특별시 종로구 세종대로 209 정부서울청사",
      "서울특별시 종로구 세종대로 209"
     ],
     [
      "경기도 성남시 분당구 판교로 235, 101동 1203호",
      "경기도 성남시 분당구 판교로 235, 101동 1203호"
     ],
     [
      "부산 해운대구 우동 1234-5 번지",
      "부산 해운대구 우동 1234-5 번지"
     ],
     [
      "주소: 강원도 춘천시 중앙로 12",
      "강원도 춘천시 중앙로 12"
     ],
     [
      "송파구 올림픽로 300 근처",
      "송파구 올림픽로 300"
     ]
    ],
    "neg": [
     "제1조 이 법은 서울 지역 개발에 관하여",
     "경기가 좋아 매출이 늘었다"
    ]
   },
   "require": "(?:로|길)\\s?\\d|(?:동|읍|면|리|가)\\s?\\d|^\\s*(?:서울|부산|대구|인천|광주|대전|울산|세종|경기|강원|충북|충남|전북|전남|경북|경남|제주)",
   "free": true
  },
  {
   "id": "postcode",
   "label": "우편번호",
   "group": "C",
   "level": "standard",
   "numeric": true,
   "disclose": "none",
   "patterns": [],
   "labels": [
    "우편번호",
    "우편 번호",
    "우)",
    "우편물 수령지 우편번호"
   ],
   "value": "\\d{5}(?!\\d)|\\d{3}-\\d{3}",
   "tests": {
    "pos": [
     [
      "우편번호 03171",
      "03171"
     ],
     [
      "우편번호: 135-080",
      "135-080"
     ]
    ],
    "neg": [
     "번호 12345"
    ]
   }
  },
  {
   "id": "phone",
   "label": "전화번호",
   "group": "C",
   "level": "standard",
   "numeric": true,
   "disclose": "phone",
   "patterns": [
    {
     "re": "(?<![\\d-])(?:\\+82[\\s-]?(?:\\(0\\))?|0)1[016789][\\s.-]?\\d{3,4}[\\s.-]?\\d{4}(?![\\d-])"
    },
    {
     "re": "(?<![\\d-])\\(?0(?:2|[3-6][1-5])\\)?[\\s.-]?\\d{3,4}[\\s.-]?\\d{4}(?![\\d-])"
    },
    {
     "re": "(?<![\\d-])0[57]0\\d?[\\s.-]?\\d{3,4}[\\s.-]?\\d{4}(?![\\d-])"
    }
   ],
   "labels": [
    "전화번호",
    "전화",
    "연락처",
    "휴대전화",
    "휴대폰",
    "핸드폰",
    "휴대전화번호",
    "팩스",
    "FAX",
    "Tel\\.?",
    "TEL",
    "자택 전화",
    "직장 전화",
    "비상연락처"
   ],
   "value": "[\\d(][\\d()\\s.+-]{7,16}\\d",
   "tests": {
    "pos": [
     [
      "010-1234-5678로 연락",
      "010-1234-5678"
     ],
     [
      "연락처 01098765432",
      "01098765432"
     ],
     [
      "(02) 123-4567",
      "(02) 123-4567"
     ],
     [
      "031-123-4567",
      "031-123-4567"
     ],
     [
      "+82 10-2345-6789",
      "+82 10-2345-6789"
     ],
     [
      "070-4321-8765",
      "070-4321-8765"
     ],
     [
      "0504-1234-5678",
      "0504-1234-5678"
     ],
     [
      "전화 051.123.4567",
      "051.123.4567"
     ]
    ],
    "neg": [
     "법령 제2026-1234호",
     "일련번호 1234-5678",
     "금액 1,234,567원"
    ]
   }
  },
  {
   "id": "email",
   "label": "이메일",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "email",
   "patterns": [
    {
     "re": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+"
    }
   ],
   "labels": [],
   "tests": {
    "pos": [
     [
      "메일 hong.gd@mail.example.com 로",
      "hong.gd@mail.example.com"
     ],
     [
      "a_b+c@mail.example.org",
      "a_b+c@mail.example.org"
     ]
    ],
    "neg": [
     "골뱅이 @ 기호만",
     "id@"
    ]
   }
  },
  {
   "id": "handle",
   "label": "계정",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "none",
   "patterns": [
    {
     "re": "https?://(?:www\\.)?(?:instagram\\.com|facebook\\.com|twitter\\.com|x\\.com|t\\.me|open\\.kakao\\.com|tiktok\\.com/@?)/[A-Za-z0-9._/-]+"
    },
    {
     "re": "(?<![\\w@.])@[A-Za-z][A-Za-z0-9._]{3,29}(?![\\w.]*@)"
    }
   ],
   "labels": [
    "카카오톡",
    "카카오톡 ID",
    "카톡",
    "카톡 ID",
    "인스타그램",
    "인스타",
    "페이스북",
    "트위터",
    "텔레그램",
    "라인 ID",
    "SNS",
    "아이디",
    "ID",
    "홈페이지",
    "블로그"
   ],
   "value": "@?[A-Za-z0-9][A-Za-z0-9._-]{3,30}",
   "tests": {
    "pos": [
     [
      "카카오톡 ID hong_gd77",
      "hong_gd77"
     ],
     [
      "https://www.instagram.com/hong.gd77 참고",
      "https://www.instagram.com/hong.gd77"
     ],
     [
      "인스타 @hong_gd77",
      "@hong_gd77"
     ]
    ],
    "neg": [
     "ID 카드 사본"
    ]
   },
   "free": true
  },
  {
   "id": "ip",
   "label": "IP",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "none",
   "patterns": [
    {
     "re": "(?<![\\d.])(?:\\d{1,3}\\.){3}\\d{1,3}(?![\\d.])",
     "check": "ipv4"
    }
   ],
   "labels": [],
   "tests": {
    "pos": [
     [
      "접속 IP 203.0.113.45 기록",
      "203.0.113.45"
     ],
     [
      "192.168.0.12",
      "192.168.0.12"
     ]
    ],
    "neg": [
     "버전 1.2.3",
     "300.1.1.1",
     "2026.11.16"
    ]
   }
  },
  {
   "id": "mac",
   "label": "MAC",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "none",
   "patterns": [
    {
     "re": "(?<![0-9A-Fa-f:-])(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}(?![0-9A-Fa-f:-])"
    }
   ],
   "labels": [],
   "tests": {
    "pos": [
     [
      "MAC 00:1A:2B:3C:4D:5E",
      "00:1A:2B:3C:4D:5E"
     ]
    ],
    "neg": [
     "시각 12:30:45"
    ]
   }
  },
  {
   "id": "gps",
   "label": "좌표",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "none",
   "patterns": [
    {
     "re": "(?<!\\d)-?\\d{1,2}\\.\\d{4,},\\s*-?\\d{2,3}\\.\\d{4,}(?!\\d)"
    }
   ],
   "labels": [],
   "tests": {
    "pos": [
     [
      "위치 37.566535, 126.977969 부근",
      "37.566535, 126.977969"
     ]
    ],
    "neg": [
     "비율 3.5, 4.25"
    ]
   }
  },
  {
   "id": "plate",
   "label": "차량번호",
   "group": "C",
   "level": "standard",
   "numeric": false,
   "disclose": "plate",
   "patterns": [
    {
     "re": "(?<![\\d제])\\d{2,3}\\s?[{{PLATE}}]\\s?\\d{4}(?!\\d)"
    }
   ],
   "labels": [
    "차량번호",
    "차량 번호",
    "자동차등록번호",
    "차번호"
   ],
   "value": "\\d{2,3}\\s?[{{PLATE}}]\\s?\\d{4}",
   "tests": {
    "pos": [
     [
      "차량번호 12가 3456",
      "12가 3456"
     ],
     [
      "123나4567 차량",
      "123나4567"
     ],
     [
      "서울 34바 7890",
      "34바 7890"
     ]
    ],
    "neg": [
     "제12조 3456",
     "2026가 합"
    ]
   }
  }
 ]
}